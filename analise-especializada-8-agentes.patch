diff --git a/src/main/java/com/rafaelvianna/legalanalyzer/analysis/research/AllowlistLegalSourceProvider.java b/src/main/java/com/rafaelvianna/legalanalyzer/analysis/research/AllowlistLegalSourceProvider.java
