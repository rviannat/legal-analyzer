diff --git a/src/main/java/com/rafaelvianna/legalanalyzer/web/dto/specialized/TipoRascunho.java b/src/main/java/com/rafaelvianna/legalanalyzer/web/dto/specialized/TipoRascunho.java
new file mode 100644
index 0000000..232e57c
--- /dev/null
+++ b/src/main/java/com/rafaelvianna/legalanalyzer/web/dto/specialized/TipoRascunho.java
@@ -0,0 +1,21 @@
+package com.rafaelvianna.legalanalyzer.web.dto.specialized;
+
+/** Tipos de rascunho que o Drafting Agent pode produzir (sempre para revisão do advogado). */
+public enum TipoRascunho {
+    PARECER,
+    MANIFESTACAO,
+    RELATORIO,
+    PETICAO,
+    EMAIL_CLIENTE;
+
+    /** Descrição usada nos prompts para orientar o formato esperado. */
+    public String descricao() {
+        return switch (this) {
+            case PARECER -> "parecer jurídico (consulta, análise fundamentada e conclusão)";
+            case MANIFESTACAO -> "manifestação processual objetiva a ser protocolada nos autos";
+            case RELATORIO -> "relatório técnico interno sobre o caso, para uso do escritório";
+            case PETICAO -> "petição (endereçamento, fatos, fundamentos, pedidos e fechamento)";
+            case EMAIL_CLIENTE -> "e-mail ao cliente em linguagem clara, sem jargão excessivo";
+        };
+    }
+}
diff --git a/src/main/resources/application-example.yml b/src/main/resources/application-example.yml
index bd50561..911d67f 100644
--- a/src/main/resources/application-example.yml
+++ b/src/main/resources/application-example.yml
@@ -29,3 +29,25 @@
 #   --legal-analyzer.ai.api-key=sk-ant-... \
 #   --legal-analyzer.ai.model=claude-sonnet-4-5 \
 #   --legal-analyzer.ai.base-url=https://api.anthropic.com/v1/messages
+#
+# --- Análise especializada (8 agentes) ---
+#
+#   export ESPECIALIZADA_AMOSTRA_CHARS="16000"       # amostra de texto enviada aos agentes
+#   export ESPECIALIZADA_MAX_RASCUNHOS="5"          # rascunhos por requisição
+#   export ESPECIALIZADA_MAX_CHARS_RASCUNHO="8000"  # tamanho máximo de cada rascunho
+#
+# --- Pesquisa jurídica (Legal Research Agent) ---
+#
+# Desabilitada por padrão. Com ela desligada, o agente informa que não pesquisou
+# e NENHUMA legislação ou jurisprudência é citada — evita referência inventada.
+#
+#   export LEGAL_RESEARCH_ENABLED="true"
+#   export LEGAL_RESEARCH_MAX_CHARS="8000"
+#   export LEGAL_RESEARCH_MAX_FONTES="3"
+#   export LEGAL_RESEARCH_TIMEOUT_SECONDS="20"
+#
+# A allowlist de domínios e as fontes (url-template com {consulta}) ficam em
+# application.yml, em legal-analyzer.legal-research. Só URLs cujo host esteja
+# na allowlist são baixadas — a checagem é refeita após cada redirecionamento.
+# Para adicionar uma fonte própria (ex.: tribunal estadual ou base interna),
+# inclua o domínio na allowlist e a url-template na lista de fontes.
diff --git a/src/main/resources/application.yml b/src/main/resources/application.yml
index cfc6999..4f952a5 100644
--- a/src/main/resources/application.yml
+++ b/src/main/resources/application.yml
@@ -33,6 +33,41 @@ legal-analyzer:
     chunk-char-size: 20000             # ~ tamanho de trecho enviado por chamada de IA
     chunk-overlap-chars: 2000          # sobreposição entre trechos para não perder contexto
 
+  especializada:
+    # amostra do texto original enviada aos agentes especializados
+    amostra-texto-chars: ${ESPECIALIZADA_AMOSTRA_CHARS:16000}
+    # quantidade maxima de rascunhos por requisicao (Drafting Agent)
+    max-rascunhos: ${ESPECIALIZADA_MAX_RASCUNHOS:5}
+    # tamanho maximo aproximado de cada rascunho gerado
+    max-chars-rascunho: ${ESPECIALIZADA_MAX_CHARS_RASCUNHO:8000}
+  # Pesquisa juridica: SOMENTE fontes autorizadas e rastreaveis.
+  # Desabilitada por padrao -> o Legal Research Agent informa que nao pesquisou,
+  # em vez de permitir que o modelo cite legislacao/jurisprudencia de memoria.
+  legal-research:
+    enabled: ${LEGAL_RESEARCH_ENABLED:false}
+    # allowlist de dominios: qualquer URL fora desta lista e' recusada (inclusive apos redirect)
+    dominios-autorizados:
+      - planalto.gov.br
+      - lexml.gov.br
+      - stf.jus.br
+      - stj.jus.br
+      - tst.jus.br
+      - cnj.jus.br
+      - senado.leg.br
+      - camara.leg.br
+      - in.gov.br
+    # endpoints de busca; {consulta} e' substituido pela consulta (URL-encoded)
+    fontes:
+      - nome: "LexML - legislacao e jurisprudencia (Rede de Informacao Legislativa e Juridica)"
+        url-template: "https://www.lexml.gov.br/busca/search?keyword={consulta}"
+      - nome: "STF - pesquisa de jurisprudencia"
+        url-template: "https://jurisprudencia.stf.jus.br/pages/search?base=acordaos&query={consulta}"
+      - nome: "STJ - pesquisa de jurisprudencia"
+        url-template: "https://scon.stj.jus.br/SCON/pesquisar.jsp?b=ACOR&livre={consulta}"
+    max-chars-por-fonte: ${LEGAL_RESEARCH_MAX_CHARS:8000}
+    max-fontes-por-consulta: ${LEGAL_RESEARCH_MAX_FONTES:3}
+    timeout-seconds: ${LEGAL_RESEARCH_TIMEOUT_SECONDS:20}
